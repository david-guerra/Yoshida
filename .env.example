# Copy to .env (and/or web-caller/.env.local) and fill in real values.

# --- LiveKit ---
# Server-side credentials. Used by the Python agent and by the web-caller's
# /api/token route to mint access tokens. Never expose the secret to the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser-visible LiveKit URL (the web-caller client connects directly to this).
# Must be the wss:// URL of your LiveKit server / LiveKit Cloud project.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- PocketBase ---
POCKETBASE_URL=http://127.0.0.1:8090
