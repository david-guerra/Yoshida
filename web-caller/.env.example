# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Next.js loads .env.local automatically for `next dev` / `next build`.

# Server-only — used by the /api/token route to mint LiveKit access tokens.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser-visible — the wss:// URL the caller connects to (LiveKit Cloud or self-hosted).
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
