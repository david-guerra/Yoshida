# Copy to .env.local; keep credentials server-only.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Browser-visible project WebSocket URL; fill before building.
NEXT_PUBLIC_LIVEKIT_URL=
# Optional server URL override (otherwise uses the public URL):
# LIVEKIT_URL=
# Server callback origin passed to the worker. Keep this on loopback.
CALL_SERVER_URL=http://127.0.0.1:3000
# Private durable call/submission ledger. Relative paths resolve from web-caller.
CALL_DATABASE_PATH=.call-data/calls.sqlite
# Server-only PocketBase origin for submission and receipt recovery.
POCKETBASE_URL=http://127.0.0.1:8090
# Synthetic lookup identity; must match the agent and synthetic backend.
SIMULATED_CALLER_PHONE=+12025550102
